# ==============================================================================
# FrankenPHP Development Server Environment Configuration
# ==============================================================================

# Server Domain & Binding
SERVER_NAME=:80, :443, localhost
APP_ENV=local
APP_DEBUG=true

# Port Bindings
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
ADMINER_PORT=8080
CADDY_ADMIN_PORT=2019

# Mercure Real-Time Hub Settings
MERCURE_PUBLISHER_JWT_KEY=FrankenPHPMercurePublisherSecretKey2026Dev!
MERCURE_SUBSCRIBER_JWT_KEY=FrankenPHPMercureSubscriberSecretKey2026Dev!
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure
MERCURE_INTERNAL_URL=http://127.0.0.1:80/.well-known/mercure

# PHP Runtime Settings
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M
PHP_MAX_EXECUTION_TIME=300
XDEBUG_MODE=off

# User & Group Mapping (Matches host user coorti: 1000)
PUID=1000
PGID=1000
