{
    frankenphp
    order mercure before respond
}

{$SERVER_NAME::80, :443, localhost} {
    root * /app
    encode zstd gzip

    # Built-in Mercure Real-Time Hub
    mercure {
        publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY:FrankenPHPMercurePublisherSecretKey2026Dev!}
        subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY:FrankenPHPMercureSubscriberSecretKey2026Dev!}
        cors_origins *
        publish_origins *
        anonymous
        subscriptions
    }

    # Health Check Endpoint
    @healthcheck path /healthz
    handle @healthcheck {
        respond "OK" 200
    }

    # 1. Auto-detect modern PHP projects with a public/ directory (e.g. Laravel, Symfony)
    @hasPublic {
        not path */public*
        path_regexp p ^/([^/]+)(/.*)?$
        file {re.p.1}/public/index.php
    }
    rewrite @hasPublic /{re.p.1}/public{re.p.2}

    # 2. Redirect root of SPA app/ subfolder projects: /project -> /project/app/
    @hasAppSpaRoot {
        path_regexp p ^/([^/]+)/?$
        file {re.p.1}/app/index.html
    }
    redir @hasAppSpaRoot /{re.p.1}/app/ 302

    # 3. SPA Client-Side Routing for app/ subfolder (fallback non-file routes to app/index.html, except .php files)
    @appSpaRoute {
        path_regexp p ^/([^/]+)/app/(.*)$
        not path *.php
        not file {path}
        file {re.p.1}/app/index.html
    }
    rewrite @appSpaRoute /{re.p.1}/app/index.html

    # 4. Root-level SPA projects (fallback non-file routes to index.html, except .php files)
    @rootSpaRoute {
        path_regexp p ^/([^/]+)/(.*)$
        not path *.php
        not path */app/*
        not path */public/*
        not file {path}
        file {re.p.1}/index.html
    }
    rewrite @rootSpaRoute /{re.p.1}/index.html

    # Standard FrankenPHP PHP server (drop-in files and folders)
    php_server

    # Static file fallback
    file_server
}
