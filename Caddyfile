{
    frankenphp
    order mercure before respond
}

{$SERVER_NAME::80, :443, localhost} {
    root * /app
    encode zstd gzip

    # Built-in Mercure Real-Time Hub
    mercure {
        publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY:FrankenPHPMercurePublisherSecretKey2026Dev!}
        subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY:FrankenPHPMercureSubscriberSecretKey2026Dev!}
        cors_origins *
        publish_origins *
        anonymous
        subscriptions
    }

    # Health Check Endpoint
    @healthcheck path /healthz
    handle @healthcheck {
        respond "OK" 200
    }

    # 1. Auto-detect modern PHP projects with a public/ directory (e.g. Laravel, Symfony)
    @hasPublic {
        not path */public*
        path_regexp p ^/([^/]+)(/.*)?$
        file {re.p.1}/public/index.php
    }
    rewrite @hasPublic /{re.p.1}/public{re.p.2}

    # 2. Auto-detect SPA projects with an app/ directory (e.g. React/Vue frontend in app/)
    @hasAppSpaRoot {
        path_regexp p ^/([^/]+)/?$
        file {re.p.1}/app/index.html
    }
    redir @hasAppSpaRoot /{re.p.1}/app/ 302

    # 3. SPA Client-Side Routing for app/ subfolder (fallback non-file/non-dir routes to app/index.html, except .php files)
    @appSpaFallback {
        path_regexp p ^/([^/]+)/app/(.*)$
        not path *.php
        not file {path}
        file {re.p.1}/app/index.html
    }
    rewrite @appSpaFallback /{re.p.1}/app/index.html

    # Standard FrankenPHP PHP server (drop-in files, folders and try_files)
    php_server {
        try_files {path} {path}/index.php {path}/index.html index.php
    }

    # Static file fallback
    file_server
}
